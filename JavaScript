function openArtModal(card, description) {
  const image = card.querySelector('img');
  const title = card.querySelector('h3');
  const category = card.querySelector('.card-cat');

  modalImage.src = image.src;
  modalImage.alt = image.alt;
  modalCategory.textContent = category.textContent;
  modalTitle.textContent = title.textContent;
  modalDescription.textContent = description;
  modal.classList.add('is-open');
  modal.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  modal.querySelector('.modal-close').focus();
}

function closeArtModal() {
  modal.classList.remove('is-open');
  modal.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

document.querySelectorAll('#carousel-materiales .museum-card').forEach((card, index) => {
  card.addEventListener('click', () => openArtModal(card, materialDescriptions[index]));
});

document.querySelectorAll('#carousel-obras .museum-card').forEach((card, index) => {
  card.addEventListener('click', () => openArtModal(card, artworkDescriptions[index]));
});

modal.querySelectorAll('[data-close-modal]').forEach((element) => {
  element.addEventListener('click', closeArtModal);
});

document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape' && modal.classList.contains('is-open')) {
    closeArtModal();
  }
});