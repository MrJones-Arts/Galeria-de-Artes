const spotlight = document.getElementById('spotlight');

document.addEventListener('mousemove', (e) => {
  if (spotlight) {
    spotlight.style.setProperty('--mx', `${(e.clientX / window.innerWidth) * 100}%`);
    spotlight.style.setProperty('--my', `${(e.clientY / window.innerHeight) * 100}%`);
  }
});

// Generación de partículas flotantes
const particlesContainer = document.getElementById('particles-container');
const particleColors = ['#a8d4a0', '#c9a84c', '#c8e8c0'];

for (let i = 0; i < 20; i++) {
  if (!particlesContainer) break;

  const particle = document.createElement('div');
  particle.classList.add('particle');
  
  const size = 3 + Math.random() * 8;
  const xPos = Math.random() * 100;
  const delay = Math.random() * 12;
  const duration = 14 + Math.random() * 16;
  const swayDuration = 4 + Math.random() * 6;
  const swayDelay = Math.random() * 4;
  const color = particleColors[Math.floor(Math.random() * particleColors.length)];
  const opacity = 0.08 + Math.random() * 0.18;

  particle.style.width = `${size}px`;
  particle.style.height = `${size}px`;
  particle.style.left = `${xPos}%`;
  particle.style.bottom = `-20px`;
  particle.style.background = color;
  particle.style.opacity = opacity;
  particle.style.animation = `floatUp ${duration}s ${delay}s linear infinite, sway ${swayDuration}s ${swayDelay}s ease-in-out infinite`;
  
  particlesContainer.appendChild(particle);
}

// Desplaza el carrusel indicado por las flechas del HTML.
window.scrollCarousel = function (carouselId, distance) {
  const container = document.getElementById(carouselId);
  if (container) {
    container.scrollBy({
      left: distance,
      behavior: 'smooth'
    });
  }
};

const offerTrack = document.getElementById('offers-track');
const offerSlides = document.querySelectorAll('.offer-slide');
const offerDots = document.querySelectorAll('.offer-dot');
const offerPrevious = document.querySelector('.offer-arrow-prev');
const offerNext = document.querySelector('.offer-arrow-next');
let currentOffer = 0;
let offerTimer;

function showOffer(index) {
  currentOffer = (index + offerSlides.length) % offerSlides.length;
  offerTrack.style.transform = `translateX(-${currentOffer * 100}%)`;

  offerSlides.forEach((slide, slideIndex) => {
    slide.classList.toggle('is-active', slideIndex === currentOffer);
  });
  offerDots.forEach((dot, dotIndex) => {
    dot.classList.toggle('is-active', dotIndex === currentOffer);
  });
}

function startOfferRotation() {
  window.clearInterval(offerTimer);
  offerTimer = window.setInterval(() => showOffer(currentOffer + 1), 5000);
}

if (offerTrack && offerSlides.length) {
  offerPrevious.addEventListener('click', () => {
    showOffer(currentOffer - 1);
    startOfferRotation();
  });
  offerNext.addEventListener('click', () => {
    showOffer(currentOffer + 1);
    startOfferRotation();
  });
  offerDots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      showOffer(index);
      startOfferRotation();
    });
  });

  offerTrack.parentElement.addEventListener('mouseenter', () => window.clearInterval(offerTimer));
  offerTrack.parentElement.addEventListener('mouseleave', startOfferRotation);
  startOfferRotation();
}

